rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Only allow users to read and write to their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /ideal_answers/{questionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /questions/{questionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /evaluations/{evaluationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Rules for the root-level generated papers
    match /generated_papers/{paperId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Rules for the root-level ideal answers
    match /ideal_answers/{answerId} {
      allow read, write: if request.auth != null;
    }
  }
}
