rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Only allow users to read and write to their own document (excluding premium fields)
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null 
                    && request.auth.uid == userId
                    && (!('plan' in request.resource.data) || request.resource.data.plan == 'free')
                    && !('subscriptionStatus' in request.resource.data)
                    && !('expiresAt' in request.resource.data)
                    && !('razorpayPaymentId' in request.resource.data)
                    && !('razorpayOrderId' in request.resource.data)
                    && !('upgradedAt' in request.resource.data);
      allow update: if request.auth != null 
                    && request.auth.uid == userId 
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan', 'subscriptionStatus', 'expiresAt', 'razorpayPaymentId', 'razorpayOrderId', 'upgradedAt']);
      
      match /ideal_answers/{questionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /questions/{questionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /evaluations/{evaluationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /parsed_papers/{paperId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /parser_debug_reports/{reportId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Rules for the root-level generated papers
    match /generated_papers/{paperId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Rules for the root-level ideal answers
    match /ideal_answers/{answerId} {
      allow read, write: if request.auth != null;
    }
  }
}
